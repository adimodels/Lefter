# MongoDB (Atlas sau alt cluster) — Prisma se conectează prin acest URL.
DATABASE_URL="mongodb+srv://<user>:<parola>@<cluster>.mongodb.net/adiacademy?retryWrites=true&w=majority"

# Parola de acces pentru echipă în /admin (o singură parolă comună).
ADMIN_PASSWORD=""
# Secret folosit pentru semnarea cookie-ului de sesiune admin (string aleator, lung).
ADMIN_SESSION_SECRET=""

# Notificare Telegram la fiecare submission nou (opțional — dacă lipsesc, nu se trimite nimic).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Webhook pentru sincronizare automată în Google Sheets, ex. un Google Apps Script
# Web App URL sau un catch-webhook Make.com/Zapier (opțional).
SHEETS_WEBHOOK_URL=""

# Link public către Instagram-ul Adi Academy, folosit pe landing page și în confirmare.
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/adiacademy"
